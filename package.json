{
  "name": "spectratact",
  "version": "0.1.0",
  "description": "Hybrid desktop application manager with Python backend and Electron frontend",
  "main": "src/desktop/desktop-main.js",
  "scripts": {
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "pytest --cov=src/spectratact --cov-report=html:coverage/backend --cov-report=term",
    "test:frontend": "jest --config jest.config.js",
    "test:backend:watch": "pytest-watch",
    "test:frontend:watch": "jest --config jest.config.js --watch",
    "test:coverage": "npm run test:backend && npm run test:frontend -- --coverage",
    "start": "electron src/desktop/desktop-main.js --dev",
    "dev": "electron src/desktop/desktop-main.js --dev",
    "dev:win": "set NODE_ENV=development && electron src/desktop/desktop-main.js --dev",
    "dev:unix": "NODE_ENV=development electron src/desktop/desktop-main.js --dev",
    "build": "electron-builder",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --win --mac --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "desktop",
    "window-management",
    "automation",
    "electron",
    "python",
    "hybrid-app"
  ],
  "author": "dhaneshbb",
  "license": "GPL-3.0",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0"
  },
  "build": {
    "appId": "com.dhaneshbb.spectratact",
    "productName": "SpectraTact",
    "directories": {
      "output": "dist",
      "buildResources": "src/desktop/assets"
    },
    "icon": "src/desktop/assets/icons/icon.png",
    "files": [
      "src/desktop/**/*",
      "!src/desktop/node_modules",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/spectratact",
        "to": "spectratact",
        "filter": ["**/*.py", "**/*.typed"]
      },
      {
        "from": "docs/examples/settings.example.yml",
        "to": "config/settings.yml"
      },
      {
        "from": "docs/examples/loaded_apps.example.yml",
        "to": "config/loaded_apps.yml"
      },
      {
        "from": "docs/examples/load_apps.example.yml",
        "to": "config/load_apps.yml"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "scripts/setup_python.bat",
        "to": "setup_python.bat"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ],
    "win": {
      "icon": "src/desktop/assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "icon": "src/desktop/assets/icons/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "src/desktop/assets/icons/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "artifactName": "${productName}-v${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpectraTact",
      "warningsAsErrors": false,
      "installerHeaderIcon": "src/desktop/assets/icons/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-Portable.${ext}"
    },
    "dmg": {
      "title": "SpectraTact",
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 100,
          "y": 200,
          "type": "file"
        },
        {
          "x": 500,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.8.0"
  }
}
